# Base URL for the application under test
BASE_URL=https://kazis.dev

# For local testing against dev server
# BASE_URL=http://localhost:3000

# Slow down actions by this many ms (useful for debugging)
SLOW_MO=0

# CI environment flag — enables retries, GitHub reporter
CI=false

# Number of retries on failure (defaults: CI=2, local=0)
# RETRIES=0

# Number of parallel workers (defaults: CI=2, local=auto)
# WORKERS=
